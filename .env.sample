# captcha-service settings template.
#
# Copy to .env and fill in. Every value here is required unless noted.
# Prefix rules: the app reads CAPTCHA_* env vars only (CAPTCHA_REDIS_URL etc).
#
# Generate secrets with:  openssl rand -hex 32   (or `secrets.token_hex(32)`)
# Never commit your real .env — it is gitignored by design.

# Shared secret for the internal verify endpoint (server-to-server auth).
# At least 32 chars; rotate by issuing a new value and redeploying both sides.
CAPTCHA_INTERNAL_API_KEY=__replace_with_openssl_rand_hex_32__

# HS256 signing key for solve tokens. At least 32 chars.
# Rotating invalidates outstanding tokens (they fail signature checks) —cap
# that cost by scheduling rotation with your resource server.
CAPTCHA_JWT_SECRET=__replace_with_openssl_rand_hex_32__

# Redis location and credentials. In dev, the default below matches the
# compose redis (loopback, no password). In prod (docker-compose.prod.yml)
# set it to redis://:<CAPTCHA_REDIS_PASSWORD>@redis:6379/0 and set
# CAPTCHA_REDIS_PASSWORD too.
#CAPTCHA_REDIS_URL=redis://127.0.0.1:6379/0
#CAPTCHA_REDIS_PASSWORD=

# Redis socket timeouts in seconds — bounded so a wedged Redis cannot
# stall handlers indefinitely.
#CAPTCHA_REDIS_SOCKET_CONNECT_TIMEOUT=2.0
#CAPTCHA_REDIS_SOCKET_TIMEOUT=2.0

# Tunables (defaults shown).
#CAPTCHA_CHALLENGE_TTL_SECONDS=300
#CAPTCHA_TOKEN_TTL_SECONDS=300
#CAPTCHA_REDEMPTION_RETENTION_SECONDS=120
#CAPTCHA_REDIS_GRACE_SECONDS=600
#CAPTCHA_EXPIRY_SWEEP_INTERVAL_SECONDS=60
#CAPTCHA_CAPTCHA_LENGTH=6
#CAPTCHA_CAPTCHA_WIDTH=280
#CAPTCHA_CAPTCHA_HEIGHT=90

# Rate limiting (per client IP, token bucket in Redis). 0/false disables.
#CAPTCHA_RATE_LIMIT_ENABLED=true
#CAPTCHA_CHALLENGE_RATE_MAX=15         # burst capacity for POST /challenges
#CAPTCHA_CHALLENGE_RATE_PER_SECONDS=15 # sustained issuance per second per IP
#CAPTCHA_SOLVE_RATE_MAX=30
#CAPTCHA_SOLVE_RATE_PER_SECONDS=10
